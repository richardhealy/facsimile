{
  "openapi": "3.1.0",
  "info": {
    "title": "facsimile",
    "description": "Visual document RAG with late-interaction page embeddings",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "summary": "Ingest",
        "description": "Upload a PDF; rasterize, embed, and index every page.\n\nThe page images are saved under ``{DATA_DIR}/{doc_id}/`` so they can be\nserved by ``GET /pages/{doc_id}/{page_num}`` and displayed in the viewer.\n\nReturns the ``doc_id`` (derived from the filename stem) and the number of\npages indexed.",
        "operationId": "ingest_ingest_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_ingest_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/retrieve": {
      "post": {
        "summary": "Retrieve",
        "description": "Embed *query* and return the *top_k* most relevant indexed pages.",
        "operationId": "retrieve_retrieve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrieveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrieveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "summary": "Ask",
        "description": "Retrieve relevant pages and synthesize a vision-LLM grounded answer.\n\nRetrieved page images are loaded from disk (written by ``POST /ingest``)\nand passed to :func:`~facsimile.answer.synthesizer.synthesize`.  The\nresponse includes the answer text, the page numbers cited by the model,\nand the full list of retrieved pages for display in the viewer.",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pages/{doc_id}/{page_num}": {
      "get": {
        "summary": "Get Page",
        "description": "Serve a rasterized page image as PNG.",
        "operationId": "get_page_pages__doc_id___page_num__get",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Doc Id"
            }
          },
          {
            "name": "page_num",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Page Num"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/viewer": {
      "get": {
        "summary": "Viewer",
        "description": "Serve the interactive page-highlight viewer.",
        "operationId": "viewer_viewer_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 3
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "AskRequest",
        "description": "Request body for ``POST /ask``."
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "cited_pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Cited Pages"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "retrieved_pages": {
            "items": {
              "$ref": "#/components/schemas/PageInfo"
            },
            "type": "array",
            "title": "Retrieved Pages"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "cited_pages",
          "model",
          "retrieved_pages"
        ],
        "title": "AskResponse",
        "description": "Response returned by ``POST /ask``."
      },
      "Body_ingest_ingest_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_ingest_ingest_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestResponse": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "pages"
        ],
        "title": "IngestResponse",
        "description": "Response returned by ``POST /ingest``."
      },
      "PageInfo": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "page_num": {
            "type": "integer",
            "title": "Page Num"
          },
          "doc_path": {
            "type": "string",
            "title": "Doc Path"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "page_num",
          "doc_path",
          "score"
        ],
        "title": "PageInfo",
        "description": "Metadata for one retrieved page, included in retrieve and ask responses."
      },
      "RetrieveRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RetrieveRequest",
        "description": "Request body for ``POST /retrieve``."
      },
      "RetrieveResponse": {
        "properties": {
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageInfo"
            },
            "type": "array",
            "title": "Pages"
          }
        },
        "type": "object",
        "required": [
          "pages"
        ],
        "title": "RetrieveResponse",
        "description": "Response returned by ``POST /retrieve``."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
